{
  "name": "devsec",
  "private": true,
  "type": "module",
  "description": "Local DevSec(Ops) toolkit",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p packages/core/tsconfig.test.json && pnpm --filter @devsec/ui typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "fixtures": "./scripts/record-fixtures.sh",
    "equivalence": "./scripts/equivalence.sh",
    "ui": "node apps/ui/dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
